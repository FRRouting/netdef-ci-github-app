# NetDEF CI GitHub App - configuration (copy to .env; never commit the real file).
# All values below are FICTITIOUS placeholders. Real secrets belong in the environment of the service
# (Ansible Vault in deployments, see doc/10-ansible-deploy.md) with file mode 0600.

# --- runtime ---------------------------------------------------------------------------------------------------
# development | production | test. In production the app refuses to start without WEBHOOK_SECRET.
NETDEF_ENV=development
# true = DEBUG logs
DEBUG=false
# Optional directory for rotating log files (github_app.log and one pr<N>.log per pull request).
# Unset = stdout only (journald under systemd).
#LOG_DIR=/var/log/netdef-ci

# --- database (PostgreSQL; see doc/06-database-and-rollout.md) ---------------------
DATABASE_URL=postgresql+psycopg://netdef_ci:CHANGE_ME@localhost:5432/githubruns-dev
DB_POOL_SIZE=10

# --- authentication of incoming requests --------------------------------------------------------------------------
# HMAC-SHA256 secret shared with GitHub (webhook secret) and with Bamboo (sent as the signature_secret variable).
# Equivalent of `auth_signature.password`.
WEBHOOK_SECRET=CHANGE_ME_long_random_value
# 0 = no de-duplication. >0 = ignore a repeated X-GitHub-Delivery within that many seconds.
WEBHOOK_DEDUPE_TTL_SECONDS=0
# Basic Auth for GET /metrics (equivalent of `metrics_auth`). Unset = /metrics always answers 401.
METRICS_USERNAME=prometheus
METRICS_PASSWORD=CHANGE_ME

# --- GitHub App ---------------------------------------------------------------------------------------------------
# TOML file with the [[github_apps]] entries (login/cert/repo); see github_apps.example.toml.
GITHUB_APPS_FILE=./github_apps.toml
GITHUB_API_URL=https://api.github.com
# Name of the GitHub App; check runs of this app that are not in the stage list are marked as skipped.
GITHUB_APP_NAME=NetDEF CI Hook
GITHUB_MAX_RETRIES=3

# --- Bamboo ---------------------------------------------------------------------------------------------------------
# Bamboo is normally reached locally / through a tunnel, hence the default of no TLS verification.
BAMBOO_BASE_URL=https://127.0.0.1
BAMBOO_VERIFY_TLS=false
# Credentials: BAMBOO_USERNAME/BAMBOO_PASSWORD or, when unset, ~/.netrc machine BAMBOO_NETRC_MACHINE.
#BAMBOO_USERNAME=ci-bot
#BAMBOO_PASSWORD=CHANGE_ME
BAMBOO_NETRC_MACHINE=ci1.netdef.org
# Host used to build the links https://<CI_URL>/browse/<KEY> shown in checks and Slack.
CI_URL=ci1.netdef.org
# true = stage names get the plan name suffix when a PR has several plans (`multi_plan?` in config.yml).
MULTI_PLAN=false

# --- Slack bot ------------------------------------------------------------------------------------------------------
# Unset = notifications are disabled. Credentials: SLACK_BOT_USERNAME/PASSWORD or ~/.netrc machine slack_bot.netdef.org.
#SLACK_BOT_URL=https://slack-bot.example.invalid
#SLACK_BOT_USERNAME=slack-bot
#SLACK_BOT_PASSWORD=CHANGE_ME
SLACK_BOT_NETRC_MACHINE=slack_bot.netdef.org
SLACK_BOT_VERIFY_TLS=true

HTTP_TIMEOUT_SECONDS=30

# --- background jobs (defaults) ----------------------------------------------------------------------
JOB_MAX_ATTEMPTS=5
JOB_MAX_RUN_TIME_SECONDS=300
JOB_SLEEP_DELAY_SECONDS=5
STATUS_DEBOUNCE_SECONDS=30
CREATE_EXECUTION_DELAY_SECONDS=5
RERUN_DELAY_SECONDS=1
TIMEOUT_CHECK_MINUTES=30
TIMEOUT_HANG_HOURS=2

# --- metrics ----------------------------------------------------------------------------------------------------------
# Directory shared by the web and worker processes (prometheus_client multiprocess mode). Must be writable and local.
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_metrics
CI_METRICS_WINDOW_HOURS=24
# Number of web (uvicorn) worker processes, reported by the puma_workers_total metric.
WEB_WORKERS=1
