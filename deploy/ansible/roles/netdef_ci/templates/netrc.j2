# {{ ansible_managed }}
{% if netdef_ci_bamboo_username and netdef_ci_bamboo_password %}
machine {{ netdef_ci_bamboo_netrc_machine }}
  login {{ netdef_ci_bamboo_username }}
  password {{ netdef_ci_bamboo_password }}
{% endif %}
