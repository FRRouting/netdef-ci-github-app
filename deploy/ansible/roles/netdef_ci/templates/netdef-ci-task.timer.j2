[Unit]
Description=Runs NetDEF CI GitHub App (Ruby) task {{ item.key }}

[Timer]
OnCalendar={{ item.value.on_calendar }}
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
