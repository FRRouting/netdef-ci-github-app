# {{ ansible_managed }}
# github_http.log is rotated by the application (size based), so it is not listed here.
{{ netdef_ci_log_dir }}/github_app.log {{ netdef_ci_log_dir }}/pr*.log {
    daily
    rotate {{ netdef_ci_log_retention_days }}
    compress
    delaycompress
    missingok
    notifempty
    create 0640 {{ netdef_ci_user }} {{ netdef_ci_group }}
}
