# {{ ansible_managed }}
[Unit]
Description=NetDEF CI GitHub App - web ({{ netdef_ci_env }})
After=network-online.target
Wants=network-online.target
PartOf=netdef-ci.target

[Service]
Type=simple
User={{ netdef_ci_user }}
Group={{ netdef_ci_group }}
WorkingDirectory={{ netdef_ci_current_link }}
EnvironmentFile={{ netdef_ci_env_file }}
ExecStart={{ netdef_ci_current_link }}/venv/bin/python -m uvicorn --factory netdef_ci.web.app:app_factory --host {{ netdef_ci_listen_host }} --port {{ netdef_ci_listen_port }} --workers {{ netdef_ci_web_workers }}
Restart=always
RestartSec=5
TimeoutStopSec=30
RuntimeDirectory={{ netdef_ci_runtime_dir_name }}
RuntimeDirectoryPreserve=yes
{% include 'hardening.conf.j2' %}

[Install]
WantedBy=netdef-ci.target
