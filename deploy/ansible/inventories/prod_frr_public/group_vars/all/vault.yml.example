---
#  SPDX-License-Identifier: BSD-2-Clause
#
#  vault.yml.example
#  Part of NetDEF CI System
#
#  Copyright (c) 2026 by
#  Network Device Education Foundation, Inc. ("NetDEF")
#
# Copy to vault.yml, fill in and encrypt:   ansible-vault encrypt inventories/prod_frr_public/group_vars/all/vault.yml
# Every value below is a FICTITIOUS placeholder. Same variable names as the Python deployment's vault.
vault_netdef_ci_database_url: "postgresql://netdef_ci:CHANGE_ME@localhost:5432/githubruns-prod"
vault_netdef_ci_webhook_secret: "CHANGE_ME_long_random_value"
vault_netdef_ci_metrics_username: "prometheus"
vault_netdef_ci_metrics_password: "CHANGE_ME"
# Bamboo REST API account (written to ~/.netrc of the service user as machine ci1.netdef.org). Required unless the
# service account below is set.
# Keep the double quotes: passwords may contain characters such as ^ ! # : that YAML would otherwise interpret.
vault_netdef_ci_bamboo_username: "ci-bot"
vault_netdef_ci_bamboo_password: "CHANGE_ME"
# Bamboo 12 service account (Bamboo administration > Security > Service Accounts), with the READ, TRIGGER and WRITE
# scopes. Preferred over username/password when both values are set; the secret is shown only once, at creation.
#vault_netdef_ci_bamboo_client_id: "CHANGE_ME"
#vault_netdef_ci_bamboo_client_secret: "CHANGE_ME"
# Slack bot (optional: leave the three values out to disable it). The credentials go to ~/.netrc as
# machine slack_bot.netdef.org and also authenticate the /slack endpoints.
vault_netdef_ci_slack_bot_url: "https://slack-bot.example.invalid"
vault_netdef_ci_slack_bot_username: "slack-bot"
vault_netdef_ci_slack_bot_password: "CHANGE_ME"
# One entry per GitHub App; private_key is the PEM text (use a YAML block scalar).
vault_netdef_ci_github_apps:
  - login: "1234567"
    repo: "FRRouting/frr"
    private_key: |
      -----BEGIN RSA PRIVATE KEY-----
      REPLACE_WITH_THE_APP_PRIVATE_KEY
      -----END RSA PRIVATE KEY-----
